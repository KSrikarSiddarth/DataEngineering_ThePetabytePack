# Settings for running MobilityPulse on the SetupF cluster (Windows master VM1 + Ubuntu worker/MinIO VM2).
# Copy to .env.setupF (git ignores it), fill in the values, keep it private: it holds the MinIO password.
# Plain KEY=VALUE lines, no quotes. Use PRIVATE IPs, never localhost: the executors receive the same addresses.
S3_ENDPOINT=http://<VM2_IP>:9000
S3_ACCESS_KEY=sparkadmin
S3_SECRET_KEY=<MINIO_PASSWORD>
MASTER_IP=<MASTER_IP>
# Address of the machine that runs the driver (where you type the commands). Empty = MASTER_IP, i.e. driver on VM1.
# Running the driver on VM2 instead? Put VM2's private IP here.
DRIVER_HOST=
DRIVER_MEMORY=2g
EXECUTOR_MEMORY=3g
EXECUTOR_CORES=3
TOTAL_CORES=3
# Python on the worker machine. python3 = system Python 3.12 on VM2, which needs the packages from
# requirements-executor.txt (SetupF 8.3 style). A venv path also works: /home/azureuser/.venvs/mp312/bin/python
EXECUTOR_PYTHON=python3
# Kafka for the streaming part (runs on VM2). Leave empty if you do not stream.
KAFKA_BOOTSTRAP=
