# Copy to .env.setupF (gitignored) on VM1 and fill in. Read by scripts\run_on_cluster.ps1. Keep it private: it holds the
# MinIO password. The driver sends the keys to the executors, so VM2 needs no copy.
# MinIO on VM2: http://<VM2 private IP>:9000, and the user and password from /etc/default/minio
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# VM1's private IP (SetupC's MASTER_IP)
MASTER_IP=
# Memory and cores. Defaults fit VM2's worker next to MinIO (SPARK_WORKER_MEMORY=4g, 3 cores).
DRIVER_MEMORY=2g
EXECUTOR_MEMORY=3g
EXECUTOR_CORES=3
TOTAL_CORES=3
# Stream job only: Kafka on VM2, <VM2 private IP>:9092
KAFKA_BOOTSTRAP=
