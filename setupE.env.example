# Copy to .env.setupE (gitignored) and fill in. Read by scripts/run_on_cluster.sh on the master, and by
# scripts/land_data.sh and scripts/pull_output.sh on a worker VM (which only need AZURE_STORAGE_ACCOUNT).
AZURE_STORAGE_ACCOUNT=
# Storage account key: set it on the master only (the driver sends it to the executors). Keep this file private (chmod 600).
AZURE_STORAGE_KEY=
# The master's Tailscale address (tailscale ip -4)
MASTER_TS_IP=
# Memory and cores. Defaults match SetupE Profile 2 (VM1 + VM2); use 4g / 3 / 3 for VM1 only.
DRIVER_MEMORY=1g
EXECUTOR_MEMORY=2g
EXECUTOR_CORES=2
TOTAL_CORES=4
# Stream job only: Kafka as seen from the executors, <VM running Kafka, Tailscale address>:9092
KAFKA_BOOTSTRAP=
